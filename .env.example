# Copy to backend/.env and fill in. NEVER commit the real file.

# --- LLM: "dev" (no API, extractive, clearly labelled) | "groq" | "gemini" ---
LLM_PROVIDER=dev
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=30

# --- Embeddings: "fastembed" (local semantic model) | "hash" (lexical, offline fallback) ---
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# RAG_MIN_SCORE=0.40        # optional override; calibrate with `python -m scripts.evaluate`
RAG_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Booking ---
TIMEZONE=Asia/Kolkata
BOOKING_REQUIRE_CONFIRMATION=true   # false = a slot choice books immediately (the PDF's sample dialogue)

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_MESSAGE_CHARS=2000
LOG_LEVEL=INFO
